{
  "name": "rivalghost",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic arcade rivalry game built for NEAR.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @rivalghost/web dev",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --filter @rivalghost/verifier... build && vitest run --passWithNoTests",
    "typecheck": "pnpm --filter @rivalghost/verifier... build && pnpm --recursive run typecheck",
    "verify:serve": "pnpm --filter @rivalghost/verifier... build && pnpm --filter @rivalghost/verifier start",
    "contract:size": "cargo build --release --target wasm32-unknown-unknown -p rivalghost-contract && node tools/check-contract-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
