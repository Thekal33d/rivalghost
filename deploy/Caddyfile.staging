# Import this file from the existing Caddyfile. Accessible only via SSH tunnel.
http://127.0.0.1:8080 {
 bind 127.0.0.1
 root * /opt/rivalghost/current/web
 encode gzip
 header {
  -Server
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
 }
 request_body {
  max_size 128KB
 }
 handle /api/guest/* {
  reverse_proxy 127.0.0.1:8788 {
   header_up X-RivalGhost-Client-IP {remote_host}
  }
 }
 handle /assets/* {
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
 }
 handle {
  header Cache-Control "no-cache"
  try_files {path} /index.html
  file_server
 }
}
