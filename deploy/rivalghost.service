[Unit]
Description=RivalGhost game API and NPC worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rivalghost
Group=rivalghost
WorkingDirectory=/opt/rivalghost/current/api
EnvironmentFile=/etc/rivalghost/runtime.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rivalghost
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=768M
CPUQuota=150%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
