# Internal service only. Never prefix credentials with VITE_ or expose them in browser code.
NEAR_NETWORK=testnet
CONTRACT_ID=
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Absolute path to a private Ed25519 JWK, with owner-only filesystem permissions.
CERTIFICATE_KEY_FILE=
# At least 32 random characters. Only the authenticated game gateway receives this token.
VERIFIER_SERVICE_TOKEN=
REPLAY_DIRECTORY=./replays
PORT=8787
