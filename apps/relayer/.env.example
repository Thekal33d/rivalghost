# Local mode saves a browser pilot and authenticates it. It never calls NEAR.
APP_ORIGIN=http://localhost:5173
PORT=8788
GUEST_DATABASE=.local/guests.sqlite
BOOTSTRAP_ENABLED=false

# Enable only after a measured, approved testnet deployment and sponsor budget.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
GUEST_PARENT_ID=
CONTRACT_ID=
# Absolute path to a protected file containing an ed25519:... operator key.
OPERATOR_KEY_FILE=
GUEST_FUNDING_YOCTO=
GAS_PRICE_CAP_YOCTO=
BOOTSTRAP_DAILY_BUDGET_YOCTO=
BOOTSTRAP_DAILY_ATTEMPTS=
VERIFIER_URL=http://127.0.0.1:8787
VERIFIER_SERVICE_TOKEN=
