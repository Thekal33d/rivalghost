# Local mode saves a browser pilot and authenticates it. It never calls NEAR.
APP_ORIGIN=http://localhost:3000
PORT=8788
# Enable only behind a loopback proxy that overwrites X-RivalGhost-Client-IP.
TRUST_LOOPBACK_PROXY=false
GUEST_DATABASE=.local/guests.sqlite
BOOTSTRAP_ENABLED=false

# Enable only after a measured, approved testnet deployment and sponsor budget.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
GUEST_PARENT_ID=
CONTRACT_ID=
# Absolute path to a protected file containing an ed25519:... operator key.
OPERATOR_KEY_FILE=
GUEST_FUNDING_YOCTO=
GAS_PRICE_CAP_YOCTO=
BOOTSTRAP_DAILY_BUDGET_YOCTO=
BOOTSTRAP_DAILY_ATTEMPTS=
VERIFIER_URL=http://127.0.0.1:8787
VERIFIER_SERVICE_TOKEN=

# Developer-funded NPC inference. Leave disabled until a specific spend allowance is approved.
# Keys are SERVER-ONLY; never prefix them with VITE_. No private wallet key is needed here.
NEAR_AI_ENABLED=false
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Persistent reservation ceiling, not the provider balance; never resets at midnight.
NEAR_AI_TOTAL_BUDGET_USD=1
NEAR_AI_DAILY_REQUESTS=4
# Optional read-only staking-farm status; requires a NEAR-authenticated user's access token,
# their default organization and expected wallet account. This is NOT the inference API key.
# Confirm current provider API availability before enabling (docs show version/deprecation drift).
NEAR_AI_STAKE_ACCESS_TOKEN=
NEAR_AI_ORGANIZATION_ID=
NEAR_AI_STAKE_ACCOUNT=

# NEAR Auth uses a separate testnet signing sponsor. Disabled until configured.
NEAR_AUTH_ENABLED=false
NEAR_AUTH_RPC_URL=https://test.rpc.fastnear.com
NEAR_AUTH_SPONSOR_ID=
NEAR_AUTH_KEY_FILE=
# Explicit budget required: each attempt reserves 300 Tgas * gas cap + 1 yoctoNEAR.
# Gas price cap must be at least 1000000000 yocto/gas to cover documented upfront pricing.
NEAR_AUTH_GAS_PRICE_CAP_YOCTO=
NEAR_AUTH_DAILY_BUDGET_YOCTO=
NEAR_AUTH_MAX_DAILY_REQUESTS=

# Full v3 economy. Never enable against the legacy Crown-only contract.
ECONOMY_MODE=local-demo
ECONOMY_CONTRACT_ID=
ECONOMY_VERIFIER_KEY_FILE=
GAME_RELAY_ACCOUNT_ID=
GAME_RELAY_KEY_FILE=
GAME_RELAY_DAILY_BUDGET_YOCTO=
GAME_RELAY_DAILY_REQUESTS=
HOUND_ENABLED=false
HOUND_ACCOUNT_ID=
HOUND_KEY_FILE=
HOUND_DAILY_BUDGET_YOCTO=
HOUND_DAILY_REQUESTS=
