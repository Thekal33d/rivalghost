{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivalghost.game/schemas/settlement-certificate.v1.schema.json",
  "title": "RivalGhost v1 verifier settlement certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["certificateVersion", "challengeId", "crownId", "playerId", "rulesVersion", "seed", "loadoutHash", "replayHash", "finalStateHash", "score", "issuedAtMs", "expiresAtMs", "verifierKeyVersion", "signature"],
  "properties": {
    "certificateVersion": { "const": 1 },
    "challengeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "crownId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "playerId": { "type": "string", "minLength": 2, "maxLength": 64 },
    "rulesVersion": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "loadoutHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "replayHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalStateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "issuedAtMs": { "type": "integer", "minimum": 0 },
    "expiresAtMs": { "type": "integer", "minimum": 0 },
    "verifierKeyVersion": { "type": "integer", "minimum": 1, "maximum": 255 },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128 }
  },
  "$comment": "The verifier signs a canonical byte encoding of every field other than signature. Contract semantic checks bind these fields to the stored unresolved challenge before consuming the certificate."
}
