{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivalghost.game/schemas/replay-input.v1.schema.json",
  "title": "RivalGhost v1 replay input",
  "type": "object",
  "additionalProperties": false,
  "required": ["rulesVersion", "seed", "runs"],
  "properties": {
    "rulesVersion": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "ticks"],
        "properties": {
          "direction": { "type": "integer", "minimum": 0, "maximum": 8 },
          "ticks": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    }
  },
  "$comment": "Semantic validation additionally requires adjacent direction values to differ and the sum of all run ticks to equal exactly 3600."
}
